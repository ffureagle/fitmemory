{
  "expo": {
    "name": "FitMemory",
    "slug": "fitmemory",
    "version": "1.0.0",
    "scheme": "fitmemory",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F1EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mfurkangokbag.fitmemory",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.mfurkangokbag.fitmemory",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F1EA"
      },
      "permissions": []
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "FitMemory oturumunu güvenli biçimde açmak için Face ID kullan."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://fitmemory-api.onrender.com",
      "eas": {
        "projectId": "16246e6b-fc41-4ea3-88ed-d6fd8741c84b"
      }
    },
    "owner": "fstudio"
  }
}
