{
  "name": "fitmemory-extension",
  "version": "1.25.8",
  "type": "module",
  "description": "Build tooling for the FitMemory Manifest V3 Chrome extension",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./styles.css --minify",
    "build": "pnpm run build:css",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
