{
  "manifest_version": 3,
  "name": "FitMemory — AI Beden Bulucu",
  "description": "Sipariş geçmişini araştırır, aktif beden tablosundan size en uygun bedeni önerir.",
  "version": "1.25.26",
  "version_name": "1.25.26 — açık ölçü panelinde beden beden yürüme",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "FitMemory yan panelini aç",
    "default_icon": "fitmemory-logo.png"
  },
  "icons": {
    "16": "fitmemory-logo.png",
    "32": "fitmemory-logo.png",
    "48": "fitmemory-logo.png",
    "128": "fitmemory-logo.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "fitmemory-logo.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
