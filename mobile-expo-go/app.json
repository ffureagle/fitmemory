{
  "expo": {
    "name": "FitMemory Go",
    "slug": "fitmemory-go",
    "owner": "fstudio",
    "version": "1.25.17",
    "scheme": "fitmemorygo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/fitmemory-logo.png",
    "splash": {
      "image": "./assets/fitmemory-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mfurkangokbag.fitmemory.go",
      "buildNumber": "5",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.mfurkangokbag.fitmemory.go",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/fitmemory-logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": []
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "apiBaseUrl": "https://fitmemory-api.onrender.com",
      "eas": {
        "projectId": "5a8a7507-726a-4c74-aab9-9482265fccb9"
      }
    },
    "runtimeVersion": "exposdk:54.0.0",
    "updates": {
      "url": "https://u.expo.dev/5a8a7507-726a-4c74-aab9-9482265fccb9"
    }
  }
}
